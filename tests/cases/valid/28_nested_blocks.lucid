int twice(int x) { return x * 2; }
int main() {
    int x = 1;
    {
        int x = 2;
        print(x);
        { int x = 3; print(x); }
        print(x);
    }
    print(x, twice(x));
    for (int i = 0; i < 2; i++) { int x = i * 10; print(x); }
    print(x);
    return 0;
}
