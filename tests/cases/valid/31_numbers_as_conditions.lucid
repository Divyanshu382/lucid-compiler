// expect-exit: 0
// expect-output: odd|zero|3
// expect-errors: 
int n = 3;
if (n % 2) cout << "odd" << endl;          // non-zero is true
int k = n;
while (k) k--;
if (!k) cout << "zero" << endl;
bool b = 3 + 4;                              // 7 converts to true
int t = true + true + b;                     // bools count as 1
cout << t << endl;
